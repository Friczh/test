# Required
DISCORD_TOKEN=
YOUTUBE_COOKIES_BASE64=

# Optional — sidecar location (defaults match start.sh / Dockerfile; only
# override if you're running the bot outside this project's Docker setup)
# POT_PROVIDER_URL=http://127.0.0.1:4416
# POT_SERVER_HOST=127.0.0.1
# POT_SERVER_PORT=4416

# Optional — buffering tuning (see README.md "Buffer" section for what each
# one does; defaults are sane, only set these if you're diagnosing a
# specific stutter/latency issue)
# MB_PREBUFFER_SECONDS=1.5
# MB_NETWORK_BUFFER_MS=2000
# MB_PREBUFFER_TIMEOUT_MS=8000
# MB_ASSUMED_BITRATE_BPS=128000
# MB_STALL_BUFFER_MS=400

# Optional — playlist size cap (see README.md "Playlists" section)
# MB_PLAYLIST_MAX_TRACKS=500
